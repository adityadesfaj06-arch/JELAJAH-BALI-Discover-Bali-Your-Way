# GEMINI_API_KEY: Required for server-side Gemini AI Travel Assistant API calls.
# Automatically injected at runtime by Google AI Studio Secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps JS SDK, Places API (New), Routes API, Street View, and Weather API.
# Provisioned via Google Maps Platform integration in AI Studio.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# APP_URL: Hosted application URL for callbacks and shareable links.
APP_URL="http://localhost:3000"

# OPTIONAL: Admin notification webhook URLs (Slack / Email relay)
SLACK_WEBHOOK_URL=""
ALERT_EMAIL_ENDPOINT=""
